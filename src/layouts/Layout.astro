---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown>;
  /** Pàgines internes: fora d'índexs de cerca */
  noindex?: boolean;
}
import '../styles/global.css';
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/oswald/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
// Preload dels 2 woff2 crítics (hero H1 Oswald 700 + cos Inter 400,
// subset llatí que cobreix el català). ?url fa que Vite resolgui el
// hash de dist en build: no es trenquen mai les rutes.
import oswald700 from '@fontsource/oswald/files/oswald-latin-700-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

const {
  title = 'Cursa del Fau — Més que una cursa de muntanya',
  description = 'Cursa de muntanya a Maçanet de Cabrenys. 24km, 18km i 9km. 9 d’agost de 2026.',
  image,
  jsonLd,
  noindex = false,
} = Astro.props;
---
<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ca_ES" />
    {image && (
      <>
        <meta property="og:image" content={image} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={image} />
      </>
    )}
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link rel="preload" href={oswald700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    {jsonLd && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    {import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_BEACON_TOKEN}"}`}
      />
    )}
  </head>
  <body class="bg-stone-950 font-sans text-stone-100 antialiased">
    <slot />
  </body>
</html>
