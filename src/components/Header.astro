---
const links = [
  { href: '#curses', label: 'La Cursa' },
  { href: '#programa', label: 'Programa' },
  { href: '#inscripcions', label: 'Inscripcions' },
  { href: '#resultats', label: 'Resultats' },
  { href: '#contacte', label: 'Contacte' },
];
---
<header class="sticky top-0 z-50 border-b border-stone-200 bg-stone-50/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <a href="/" class="text-lg font-extrabold tracking-tight">
      CURSA <span class="text-emerald-700">DEL FAU</span>
    </a>
    <ul class="hidden gap-6 text-sm font-medium md:flex">
      {links.map((l) => (
        <li><a href={l.href} class="hover:text-emerald-700">{l.label}</a></li>
      ))}
    </ul>
    <a
      href="#inscripcions"
      class="rounded-full bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800"
    >
      Inscriu-t'hi
    </a>
  </nav>
</header>
