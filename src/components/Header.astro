---
const links = [
  { href: '/#curses', label: 'La Cursa' },
  { href: '/pagina/inscripcions', label: 'Inscripcions' },
  { href: '/resultats', label: 'Resultats' },
  { href: '/imatges', label: 'Imatges' },
  { href: '/#contacte', label: 'Contacte' },
];
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-night-950/85 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3" aria-label="Principal">
    <a href="/" aria-label="Cursa del Fau — inici">
      <img src="/logo-fau-blanc.png" alt="Cursa del Fau" width="276" height="60" class="h-9 w-auto" />
    </a>
    <ul class="hidden gap-6 text-[13px] font-semibold uppercase tracking-wider text-stone-300 md:flex">
      {links.map((l) => (
        <li><a href={l.href} class="transition hover:text-fau-400">{l.label}</a></li>
      ))}
    </ul>
    <div class="flex items-center gap-2">
      <button
        id="menu-btn"
        type="button"
        class="rounded-lg p-2 text-white transition hover:bg-white/10 md:hidden"
        aria-expanded="false"
        aria-controls="menu-mobil"
        aria-label="Obrir menú"
      >
        <svg id="menu-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="7" x2="21" y2="7" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="17" x2="21" y2="17" /></svg>
        <svg id="menu-icon-close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19" /><line x1="19" y1="5" x2="5" y2="19" /></svg>
      </button>
    </div>
  </nav>
  <nav id="menu-mobil" class="hidden border-t border-white/10 bg-night-950/95 px-4 pb-6 pt-2 backdrop-blur md:hidden" aria-label="Mòbil">
    <ul class="space-y-1">
      {links.map((l) => (
        <li>
          <a href={l.href} class="font-display block rounded-lg px-3 py-3 text-xl font-semibold uppercase tracking-wide text-white transition hover:bg-white/5 hover:text-fau-400">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('menu-mobil');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  btn?.addEventListener('click', () => {
    const obert = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(obert));
    btn.setAttribute('aria-label', obert ? 'Tancar menú' : 'Obrir menú');
    iconOpen?.classList.toggle('hidden', obert);
    iconClose?.classList.toggle('hidden', !obert);
  });
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
