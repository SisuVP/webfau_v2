---
interface Props {
  s: { nom: string; url?: string; logoUrl?: string; targetaFosca?: boolean };
}
const { s } = Astro.props;
const fosc = !!s.targetaFosca;
---
<li class={`flex min-h-28 items-center justify-center rounded-xl border p-5 transition hover:shadow-md ${fosc ? 'border-white/10 bg-night-900' : 'border-stone-200 bg-white'}`}>
  {s.url ? (
    <a href={s.url} target="_blank" rel="noopener" title={s.nom} class="flex h-full w-full items-center justify-center">
      {s.logoUrl ? (
        <img src={`${s.logoUrl}?w=500&auto=format`} alt={s.nom} loading="lazy" class="max-h-20 w-auto max-w-full object-contain" />
      ) : (
        <span class={`text-center text-sm font-semibold ${fosc ? 'text-white' : ''}`}>{s.nom}</span>
      )}
    </a>
  ) : (
    <span class={`text-center text-sm font-semibold ${fosc ? 'text-white' : ''}`}>{s.nom}</span>
  )}
</li>
