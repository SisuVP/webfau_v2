---
interface Props {
  s: { nom: string; url?: string; logoUrl?: string; targetaFosca?: boolean };
  gran?: boolean;
}
const { s, gran = false } = Astro.props;
const fosc = !!s.targetaFosca;
---
<li class={`${gran ? '' : 'w-full max-w-60 justify-self-center'} flex ${gran ? 'min-h-28' : 'min-h-24'} items-center justify-center rounded-lg border p-3 transition hover:shadow-md ${fosc ? 'border-white/10 bg-night-900' : 'border-stone-200 bg-white'}`}>
  {s.url ? (
    <a href={s.url} target="_blank" rel="noopener" title={s.nom} class="flex h-full w-full items-center justify-center">
      {s.logoUrl ? (
        <img src={`${s.logoUrl}?w=${gran ? '600' : '400'}&auto=format`} alt={s.nom} loading="lazy" class={`${gran ? 'h-20' : 'h-16'} w-auto max-w-full object-contain`} />
      ) : (
        <span class={`text-center text-sm font-semibold ${fosc ? 'text-white' : ''}`}>{s.nom}</span>
      )}
    </a>
  ) : (
    <span class={`text-center text-sm font-semibold ${fosc ? 'text-white' : ''}`}>{s.nom}</span>
  )}
</li>
