---
interface Props {
  s: { nom: string; url?: string; logoUrl?: string };
}
const { s } = Astro.props;
---
<li class="flex min-h-24 items-center justify-center rounded-xl border border-stone-200 bg-white p-4 transition hover:shadow-md">
  {s.url ? (
    <a href={s.url} target="_blank" rel="noopener" title={s.nom} class="flex items-center justify-center">
      {s.logoUrl ? (
        <img src={`${s.logoUrl}?w=400&auto=format`} alt={s.nom} loading="lazy" class="max-h-16 w-auto object-contain" />
      ) : (
        <span class="text-center text-sm font-semibold">{s.nom}</span>
      )}
    </a>
  ) : (
    <span class="text-center text-sm font-semibold">{s.nom}</span>
  )}
</li>
