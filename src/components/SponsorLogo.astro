---
interface Props {
  s: { nom: string; url?: string; logoUrl?: string; targetaFosca?: boolean; colorFons?: string };
  gran?: boolean;
}
const { s, gran = false } = Astro.props;

// Compatibilitat: l'antic interruptor targetaFosca equival a fons negre
const color = s.colorFons ?? (s.targetaFosca ? 'negre' : 'blanc');

const fons: Record<string, string> = {
  blanc: 'border-stone-200 bg-white',
  negre: 'border-white/10 bg-night-900',
  taronja: 'border-fau-600 bg-fau-500',
  gris: 'border-stone-200 bg-stone-200',
};
const text: Record<string, string> = {
  blanc: '',
  negre: 'text-white',
  taronja: 'text-night-950',
  gris: '',
};
const estil = fons[color] ?? fons.blanc;
const textEstil = text[color] ?? '';
---
<li class={`${gran ? '' : 'w-full max-w-60 justify-self-center'} flex ${gran ? 'min-h-28' : 'min-h-24'} items-center justify-center rounded-lg border p-3 transition hover:shadow-md ${estil}`}>
  {s.url ? (
    <a href={s.url} target="_blank" rel="noopener" title={s.nom} class="flex h-full w-full items-center justify-center">
      {s.logoUrl ? (
        <img src={`${s.logoUrl}?w=${gran ? '600' : '400'}&auto=format`} alt={s.nom} loading="lazy" class={`${gran ? 'h-20' : 'h-16'} w-auto max-w-full object-contain`} />
      ) : (
        <span class={`text-center text-sm font-semibold ${textEstil}`}>{s.nom}</span>
      )}
    </a>
  ) : (
    <span class={`text-center text-sm font-semibold ${textEstil}`}>{s.nom}</span>
  )}
</li>
