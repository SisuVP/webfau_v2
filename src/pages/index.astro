---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const recorreguts = [
  {
    nom: 'Cursa del Fau 24 km',
    preu: '24€',
    dades: ['Circular 24 km, cim al Fau', '1200 m positius', 'Sortida / arribada Camp de Futbol'],
  },
  {
    nom: 'Puja i baixa 18 km',
    preu: '22€',
    dades: ['Circular 18 km, cim al Fau', '950 m positius', 'Sortida / arribada Camp de Futbol'],
  },
  {
    nom: 'Entre Aigües 9 km',
    preu: '19€',
    dades: ['Circular 9 km', '400 m positius', 'Ideal per iniciar-se'],
  },
];
---
<Layout>
  <Header />

  <main>
    <section class="mx-auto max-w-6xl px-4 pb-10 pt-16 text-center">
      <p class="inline-block rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold uppercase tracking-widest text-emerald-800">
        19a edició — 9 d'agost de 2026
      </p>
      <h1 class="mx-auto mt-4 max-w-3xl text-4xl font-black leading-tight md:text-6xl">
        Més que una cursa de muntanya
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-stone-600">
        Tres recorreguts pels corriols del Fau, la carena i les riberes de Maçanet de Cabrenys.
        Tria el teu repte.
      </p>
      <div class="mt-6 flex justify-center gap-3">
        <a href="#inscripcions" class="rounded-full bg-emerald-700 px-6 py-3 font-semibold text-white hover:bg-emerald-800">
          Inscripcions
        </a>
        <a href="#curses" class="rounded-full border border-stone-300 px-6 py-3 font-semibold hover:border-stone-500">
          Veure recorreguts
        </a>
      </div>
    </section>

    <section id="curses" class="mx-auto max-w-6xl px-4 py-10">
      <h2 class="text-2xl font-bold">Recorreguts</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {recorreguts.map((r) => (
          <article class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-bold">{r.nom}</h3>
            <p class="mt-1 text-3xl font-black text-emerald-700">{r.preu}</p>
            <ul class="mt-4 space-y-2 text-sm text-stone-600">
              {r.dades.map((d) => <li>• {d}</li>)}
            </ul>
            <a href="#inscripcions" class="mt-6 inline-block font-semibold text-emerald-700 underline">
              Informació →
            </a>
          </article>
        ))}
      </div>
    </section>

    <section id="programa" class="mx-auto max-w-6xl px-4 py-10">
      <div class="rounded-2xl bg-stone-950 p-8 text-stone-100">
        <h2 class="text-2xl font-bold">Programa 2026 <span class="text-sm font-normal text-stone-400">(contingut editable des de Sanity)</span></h2>
        <p class="mt-2 text-sm text-stone-300">
          Aquest bloc es substituirà per dades reals de Sanity: <code>edicio -&gt; programa</code>.
          Els editors podran crear pàgines sense tocar codi.
        </p>
      </div>
    </section>

    <section id="inscripcions" class="mx-auto max-w-6xl px-4 py-10 text-center">
      <h2 class="text-2xl font-bold">Inscripcions</h2>
      <p class="mt-2 text-stone-600">Les inscripcions es gestionen a la plataforma externa de cronometratge.</p>
      <a href="https://www.cursadelfau.org/index.php/inscripcions/" class="mt-4 inline-block rounded-full bg-stone-900 px-6 py-3 font-semibold text-white">
        Anar a inscripcions
      </a>
    </section>

    <section id="resultats" class="mx-auto max-w-6xl px-4 py-10">
      <h2 class="text-2xl font-bold">Resultats i Imatges</h2>
      <p class="mt-2 text-stone-600">Històric per edicions: 2026, 2025, 2024... gestionat com a col·lecció a Sanity.</p>
    </section>
  </main>

  <Footer />
</Layout>
