---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PortableText from '../components/PortableText.astro';
import { sanity, queries } from '../lib/sanity';

type Recorregut = {
  nom: string;
  slug?: string;
  distanciaKm?: number;
  desnivell?: number;
  preu?: number;
  puntSortida?: string;
  imatgeUrl?: string;
};

type Sponsor = {
  nom: string;
  url?: string;
  categoria?: string;
  logoUrl?: string;
};

const mocks: Recorregut[] = [
  { nom: 'Cursa del Fau 24 km', distanciaKm: 24, desnivell: 1200, preu: 24 },
  { nom: 'Puja i baixa 18 km', distanciaKm: 18, desnivell: 950, preu: 22 },
  { nom: 'Entre Aigües 9 km', distanciaKm: 9, desnivell: 400, preu: 19 },
];

let edicio: { any?: number; data?: string; programa?: any[]; reglament?: any[]; cartellUrl?: string } | null = null;
let recorreguts: Recorregut[] = mocks;
let sponsors: Sponsor[] = [];
let fromSanity = false;

try {
  const [ed, recs, spons] = await Promise.all([
    sanity.fetch(queries.edicioActual),
    sanity.fetch<Recorregut[]>(queries.recorreguts),
    sanity.fetch<Sponsor[]>(queries.sponsors),
  ]);
  if (ed) edicio = ed;
  if (recs?.length) {
    recorreguts = recs;
    fromSanity = true;
  }
  if (spons?.length) sponsors = spons;
} catch {
  // Sense connexió: mostrem mocks
}

function teaser(blocks: any[] = [], maxChars = 300) {
  const out: any[] = [];
  let n = 0;
  for (const b of blocks) {
    if (b?._type !== 'block' || !Array.isArray(b.children)) continue;
    const t = b.children.map((c: any) => c.text ?? '').join('');
    if (!t.trim()) continue;
    out.push(b);
    n += t.length;
    if (n >= maxChars) break;
  }
  return out;
}

const programaTeaser = teaser(edicio?.programa);
const reglamentTeaser = teaser(edicio?.reglament);
---
<Layout>
  <Header />

  <main>
    <section class="mx-auto max-w-6xl px-4 pb-10 pt-16 text-center">
      <p class="inline-block rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold uppercase tracking-widest text-emerald-800">
        19a edició — 9 d'agost de 2026
      </p>
      <h1 class="mx-auto mt-4 max-w-3xl text-4xl font-black leading-tight md:text-6xl">
        Més que una cursa de muntanya
      </h1>      <p class="mx-auto mt-4 max-w-2xl text-stone-600">
        Tres recorreguts pels corriols del Fau, la carena i les riberes de Maçanet de Cabrenys.
        Tria el teu repte.
      </p>
      <div class="mt-6 flex justify-center gap-3">
        <a href="/pagina/inscripcions" class="rounded-full bg-emerald-700 px-6 py-3 font-semibold text-white hover:bg-emerald-800">
          Inscripcions
        </a>
        <a href="#curses" class="rounded-full border border-stone-300 px-6 py-3 font-semibold hover:border-stone-500">
          Veure recorreguts
        </a>
      </div>
      {edicio?.cartellUrl && (
        <img
          src={`${edicio.cartellUrl}?w=1200&auto=format`}
          alt={`Cartell Cursa del Fau ${edicio.any ?? ''}`}
          loading="eager"
          class="mx-auto mt-10 max-h-[70vh] rounded-2xl object-contain shadow-lg"
        />
      )}
    </section>

    <section id="curses" class="mx-auto max-w-6xl px-4 py-10">
      <h2 class="text-2xl font-bold">
        Recorreguts {edicio?.any ? <span class="text-stone-400">· Edició {edicio.any}</span> : null}
      </h2>
      {!fromSanity && (
        <p class="mt-1 text-xs text-amber-600">Mostrant dades de mostra (Sanity no disponible en build).</p>
      )}
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {recorreguts.map((r) => (
          <article class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
            {r.imatgeUrl && (
              <img src={`${r.imatgeUrl}?w=800&auto=format`} alt={r.nom} loading="lazy" class="h-44 w-full object-cover" />
            )}
            <div class="p-6">
            <h3 class="text-lg font-bold">{r.nom}</h3>
            <p class="mt-1 text-3xl font-black text-emerald-700">{r.preu}€</p>
            <ul class="mt-4 space-y-2 text-sm text-stone-600">
              <li>• {r.distanciaKm} km circular</li>
              <li>• {r.desnivell} m positius</li>
              <li>• Sortida / arribada {r.puntSortida ?? 'Camp de Futbol'}</li>
            </ul>
            {r.slug ? (
              <a href={`/recorregut/${r.slug}`} class="mt-6 inline-block font-semibold text-emerald-700 underline">
                Informació →
              </a>
            ) : (
              <a href="#inscripcions" class="mt-6 inline-block font-semibold text-emerald-700 underline">
                Informació →
              </a>
            )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="programa" class="mx-auto max-w-6xl px-4 py-10">
      <div class="rounded-2xl bg-stone-950 p-8 text-stone-100">
        <h2 class="text-2xl font-bold">Programa {edicio?.any ?? 2026}</h2>
        {programaTeaser.length ? (
          <>
            <div class="richtext richtext-dark mt-2 text-sm text-stone-200">
              <PortableText value={programaTeaser} />
            </div>
            <a href="/programa" class="mt-4 inline-block font-semibold text-emerald-300 underline">
              Veure programa complet →
            </a>
          </>
        ) : (
          <p class="mt-2 text-sm text-stone-400">
            Pendent d'omplir: edita l'Edició a l'Studio i afegeix el <strong>Programa</strong>.
          </p>
        )}
      </div>
    </section>

    {reglamentTeaser.length ? (
      <section id="reglament" class="mx-auto max-w-6xl px-4 py-10">
        <h2 class="text-2xl font-bold">Reglament</h2>
        <div class="mt-4 rounded-2xl border border-stone-200 bg-white p-8">
          <PortableText value={reglamentTeaser} />
          <a href="/reglament" class="mt-4 inline-block font-semibold text-emerald-700 underline">
            Llegir reglament sencer →
          </a>
        </div>
      </section>
    ) : null}

    <section id="sponsors" class="mx-auto max-w-6xl px-4 py-10">
      <h2 class="text-2xl font-bold">Amb el suport de</h2>
      {sponsors.length ? (
        <ul class="mt-6 grid grid-cols-2 items-center gap-6 md:grid-cols-4">
          {sponsors.map((s) => (
            <li class="flex items-center justify-center rounded-xl border border-stone-200 bg-white p-4">
              {s.url ? (
                <a href={s.url} target="_blank" rel="noopener" title={s.nom}>
                  {s.logoUrl ? (
                    <img src={`${s.logoUrl}?w=400&auto=format`} alt={s.nom} loading="lazy" class="max-h-16 object-contain" />
                  ) : (
                    <span class="text-sm font-semibold">{s.nom}</span>
                  )}
                </a>
              ) : (
                <span class="text-sm font-semibold">{s.nom}</span>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-2 text-sm text-stone-500">
          Pendent d'omplir: crea documents <strong>Sponsor</strong> a l'Studio (nom, logo, url, categoria, ordre).
        </p>
      )}
    </section>

    <section id="inscripcions" class="mx-auto max-w-6xl px-4 py-10 text-center">
      <h2 class="text-2xl font-bold">Inscripcions</h2>
      <p class="mt-2 text-stone-600">Les inscripcions es gestionen a la plataforma externa de cronometratge.</p>
      <a href="/pagina/inscripcions" class="mt-4 inline-block rounded-full bg-stone-900 px-6 py-3 font-semibold text-white">
        Anar a inscripcions
      </a>
    </section>

    <section id="resultats" class="mx-auto max-w-6xl px-4 py-10">
      <h2 class="text-2xl font-bold">Resultats i Imatges</h2>
      <p class="mt-2 text-stone-600">Classificacions i galeries de fotos per edicions.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/resultats" class="rounded-full bg-stone-900 px-6 py-3 font-semibold text-white">
          Veure resultats
        </a>
        <a href="/imatges" class="rounded-full border border-stone-300 px-6 py-3 font-semibold hover:border-stone-500">
          Veure imatges
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
