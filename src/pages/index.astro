---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PortableText from '../components/PortableText.astro';
import SponsorLogo from '../components/SponsorLogo.astro';
import Imatge from '../components/Imatge.astro';
import { sanity, queries, type Blocs } from '../lib/sanity';

type Recorregut = {
  nom: string;
  slug?: string;
  distanciaKm?: number;
  desnivell?: number;
  preu?: number;
  puntSortida?: string;
  imatgeUrl?: string;
};

type Sponsor = {
  nom: string;
  url?: string;
  categoria?: string;
  logoUrl?: string;
  targetaFosca?: boolean;
  colorFons?: string;
  colorHex?: string;
};

const mocks: Recorregut[] = [
  { nom: 'Cursa del Fau 24 km', distanciaKm: 24, desnivell: 1200, preu: 24 },
  { nom: 'Puja i baixa 18 km', distanciaKm: 18, desnivell: 950, preu: 22 },
  { nom: 'Entre Aigües 9 km', distanciaKm: 9, desnivell: 400, preu: 19 },
];

let edicio: { any?: number; data?: string; programa?: Blocs; reglament?: Blocs; cartellUrl?: string; heroFonsUrl?: string } | null = null;
let recorreguts: Recorregut[] = mocks;
let sponsors: Sponsor[] = [];
let fromSanity = false;

try {
  const [ed, recs, spons] = await Promise.all([
    sanity.fetch(queries.edicioActual),
    sanity.fetch<Recorregut[]>(queries.recorreguts),
    sanity.fetch<Sponsor[]>(queries.sponsors),
  ]);
  if (ed) edicio = ed;
  if (recs?.length) {
    recorreguts = recs;
    fromSanity = true;
  }
  if (spons?.length) sponsors = spons;
} catch {
  // Sense connexió: mostrem mocks
}

function teaser(blocks: Blocs = [], maxChars = 300) {
  const out: Blocs = [];
  let n = 0;
  for (const b of blocks) {
    if (b?._type !== 'block' || !('children' in b) || !Array.isArray(b.children)) continue;
    const t = b.children.map((c) => ('text' in c && typeof c.text === 'string' ? c.text : '')).join('');
    if (!t.trim()) continue;
    out.push(b);
    n += t.length;
    if (n >= maxChars) break;
  }
  return out;
}

const programaTeaser = teaser(edicio?.programa ?? []);
const reglamentTeaser = teaser(edicio?.reglament ?? []);

const anyEdicio = edicio?.any ?? 2026;
const numEdicio = `${anyEdicio - 2007}a`;
const dataFormatejada = edicio?.data
  ? new Date(edicio.data + 'T00:00:00').toLocaleDateString('ca-ES', { day: 'numeric', month: 'long', year: 'numeric' })
  : '9 d’agost de 2026';
const heroFons = edicio?.heroFonsUrl ?? recorreguts.find((r) => r.imatgeUrl)?.imatgeUrl;

// La cursa es considera acabada el mateix dia a les 12:00 del migdia.
// Es calcula al build i es revalida al navegador per si el build ha quedat desfasat.
const llindarCursa = edicio?.data ? new Date(`${edicio.data}T12:00:00`) : null;
const cursaPassadaBuild = llindarCursa ? Date.now() >= llindarCursa.getTime() : false;
const ogImage = edicio?.cartellUrl ?? heroFons;

const SITE = import.meta.env.SITE_URL ?? 'https://cursadelfau.org';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `Cursa del Fau ${anyEdicio}`,
  description: 'Cursa de muntanya a Maçanet de Cabrenys: 24 km, 18 km i 9 km.',
  startDate: edicio?.data ? `${edicio.data}T07:30:00` : undefined,
  endDate: edicio?.data ? `${edicio.data}T13:00:00` : undefined,
  eventStatus: cursaPassadaBuild ? 'https://schema.org/EventCompleted' : 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: 'Camp de Futbol de Maçanet de Cabrenys',
    address: { '@type': 'PostalAddress', addressLocality: 'Maçanet de Cabrenys', addressRegion: 'Catalunya', addressCountry: 'ES' },
  },
  organizer: { '@type': 'SportsOrganization', name: 'Club Excursionista Maçanetenc', url: SITE },
  url: SITE,
  ...(ogImage ? { image: [`${ogImage}?w=1200&auto=format`] } : {}),
  subEvent: recorreguts
    .filter((r) => r.slug && r.distanciaKm != null)
    .map((r) => ({
      '@type': 'SportsEvent',
      name: r.nom,
      description: `${r.nom}: ${r.distanciaKm} km i ${r.desnivell ?? ''} m positius a Maçanet de Cabrenys.`,
      url: `${SITE}/recorregut/${r.slug}`,
      ...(edicio?.data
        ? {
            startDate: `${edicio.data}T07:30:00`,
            endDate: `${edicio.data}T13:00:00`,
            eventStatus: cursaPassadaBuild
              ? 'https://schema.org/EventCompleted'
              : 'https://schema.org/EventScheduled',
          }
        : {}),
      location: {
        '@type': 'Place',
        name: 'Camp de Futbol de Maçanet de Cabrenys',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Maçanet de Cabrenys',
          addressRegion: 'Catalunya',
          addressCountry: 'ES',
        },
      },
      organizer: { '@type': 'SportsOrganization', name: 'Club Excursionista Maçanetenc', url: SITE },
      ...(r.preu != null
        ? {
            offers: {
              '@type': 'Offer',
              price: r.preu,
              priceCurrency: 'EUR',
              url: `${SITE}/pagina/inscripcions`,
            },
          }
        : {}),
    })),
};
---
<Layout image={ogImage ? `${ogImage}?w=1200&auto=format` : undefined} jsonLd={jsonLd}>
  <Header />

  <main>
    <section class="hero-gradient relative overflow-hidden">
      {heroFons && (
        <Imatge
          src={heroFons}
          alt=""
          widths={[800, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          quality={70}
          class="absolute inset-0 h-full w-full object-cover opacity-40"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-b from-night-950/60 via-night-950/30 to-night-950"></div>
      <div class="relative mx-auto max-w-6xl px-4 pb-12 pt-24 text-center md:pb-28 md:pt-40">
        <p class="inline-block max-w-full rounded-full border border-fau-400/40 bg-fau-500/15 px-3 py-1 font-display text-xs font-semibold uppercase tracking-[0.15em] text-fau-400 sm:px-4 sm:text-sm sm:tracking-[0.2em]">
          {numEdicio} edició — {dataFormatejada}
        </p>
        <h1 class="font-display mx-auto mt-4 max-w-4xl text-balance text-[2.6rem] font-bold leading-[1] text-white sm:text-6xl md:mt-6 md:text-8xl md:leading-[0.95]">
          Més que una<br />cursa de muntanya
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-base text-stone-300 md:mt-6 md:text-lg">
          Tres recorreguts pels corriols del Fau, la carena i les riberes de Maçanet de Cabrenys.
          Tria el teu repte.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3" data-cta data-llindar={llindarCursa?.toISOString() ?? ''}>
          <div data-cta-pre class={`flex flex-wrap justify-center gap-3 ${cursaPassadaBuild ? 'hidden' : ''}`}>
            <a href="/pagina/inscripcions" class="rounded-full bg-fau-500 px-8 py-3 font-display text-lg font-semibold uppercase tracking-wide text-night-950 transition hover:bg-fau-400">
              Inscripcions
            </a>
            <a href="#curses" class="rounded-full border border-white/30 px-8 py-3 font-display text-lg font-semibold uppercase tracking-wide text-white transition hover:border-fau-400 hover:text-fau-400">
              Recorreguts
            </a>
          </div>
          <div data-cta-post class={`flex flex-wrap justify-center gap-3 ${cursaPassadaBuild ? '' : 'hidden'}`}>
            <a href="/resultats" class="rounded-full bg-fau-500 px-8 py-3 font-display text-lg font-semibold uppercase tracking-wide text-night-950 transition hover:bg-fau-400">
              Resultats
            </a>
            <a href="/imatges" class="rounded-full border border-white/30 px-8 py-3 font-display text-lg font-semibold uppercase tracking-wide text-white transition hover:border-fau-400 hover:text-fau-400">
              Imatges
            </a>
          </div>
        </div>
        <script>
          const wrap = document.querySelector('[data-cta]');
          const llindar = wrap?.getAttribute('data-llindar');
          if (wrap && llindar) {
            const passat = Date.now() >= Date.parse(llindar);
            wrap.querySelector('[data-cta-pre]')?.classList.toggle('hidden', passat);
            wrap.querySelector('[data-cta-post]')?.classList.toggle('hidden', !passat);
          }
        </script>
        <div class="mx-auto mt-8 grid max-w-3xl grid-cols-3 gap-2 md:mt-12 md:gap-3">
          {recorreguts.map((r) => (
            r.slug ? (
              <a href={`/recorregut/${r.slug}`} title={r.nom} class="rounded-lg border border-white/10 bg-white/5 px-2 py-3 backdrop-blur transition hover:border-fau-400/60 hover:bg-white/10 md:py-4">
                <p class="font-display text-2xl font-bold text-white sm:text-3xl md:text-4xl">{r.distanciaKm}<span class="text-fau-400">K</span></p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-widest text-stone-400 sm:text-[11px] md:text-xs">{r.desnivell} m +</p>
              </a>
            ) : (
              <div class="rounded-lg border border-white/10 bg-white/5 px-2 py-3 backdrop-blur md:py-4">
                <p class="font-display text-2xl font-bold text-white sm:text-3xl md:text-4xl">{r.distanciaKm}<span class="text-fau-400">K</span></p>
                <p class="mt-1 text-[10px] font-semibold uppercase tracking-widest text-stone-400 sm:text-[11px] md:text-xs">{r.desnivell} m +</p>
              </div>
            )
          ))}
        </div>
      </div>
    </section>

    <div class="bg-stone-100 text-stone-900">
    <section id="curses" class="mx-auto max-w-6xl px-4 py-14">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.25em] text-fau-600">Tria el teu repte</p>
      <h2 class="font-display mt-1 text-4xl font-bold md:text-5xl">
        Recorreguts {edicio?.any ? <span class="text-stone-500">· {edicio.any}</span> : null}
      </h2>
      {!fromSanity && (
        <p class="mt-1 text-xs text-amber-600">Mostrant dades de mostra (Sanity no disponible en build).</p>
      )}
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {recorreguts.map((r) => (
          <article class="group overflow-hidden rounded-lg bg-night-900 text-white shadow-lg transition duration-300 hover:-translate-y-1 hover:shadow-2xl">
            <div class="relative">
              {r.imatgeUrl ? (
                <Imatge src={r.imatgeUrl} alt={r.nom} widths={[400, 800]} sizes="(max-width: 768px) 100vw, 400px" quality={65} class="h-52 w-full object-cover transition duration-500 group-hover:scale-105" />
              ) : (
                <div class="hero-gradient h-52 w-full"></div>
              )}
              <span class="font-display absolute left-4 top-4 rounded-full bg-fau-500 px-3 py-1 text-sm font-bold text-night-950">
                {r.distanciaKm}K · {r.desnivell}M+
              </span>
            </div>
            <div class="p-6">
            <h3 class="font-display text-2xl font-semibold">{r.nom}</h3>
            <p class="mt-1 text-3xl font-extrabold text-fau-400">{r.preu}€</p>
            <ul class="mt-4 space-y-2 text-sm text-stone-300">
              <li>• {r.distanciaKm} km circular</li>
              <li>• {r.desnivell} m positius</li>
              <li>• Sortida / arribada {r.puntSortida ?? 'Camp de Futbol'}</li>
            </ul>
            {r.slug ? (
              <a href={`/recorregut/${r.slug}`} aria-label={`Informació: ${r.nom}`} class="mt-6 inline-block font-display text-sm font-semibold uppercase tracking-widest text-fau-400 underline-offset-4 hover:underline">
                Informació →
              </a>
            ) : (
              <a href="/pagina/inscripcions" aria-label={`Informació: ${r.nom}`} class="mt-6 inline-block font-display text-sm font-semibold uppercase tracking-widest text-fau-400 underline-offset-4 hover:underline">
                Informació →
              </a>
            )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="programa" class="mx-auto max-w-6xl px-4 py-10">
      <div class="rounded-lg border border-white/10 bg-night-900 p-8 text-stone-100">
        <p class="font-display text-sm font-semibold uppercase tracking-[0.25em] text-fau-400">No et perdis res</p>
        <h2 class="font-display mt-1 text-3xl font-bold md:text-4xl">Programa {edicio?.any ?? 2026}</h2>
        {programaTeaser.length ? (
          <>
            <div class="richtext richtext-dark mt-2 text-sm text-stone-200">
              <PortableText value={programaTeaser} />
            </div>
            <a href="/programa" class="mt-4 inline-block font-display text-sm font-semibold uppercase tracking-widest text-fau-400 underline-offset-4 hover:underline">
              Veure programa complet →
            </a>
          </>
        ) : (
          <p class="mt-2 text-sm text-stone-400">
            Pendent d'omplir: edita l'Edició a l'Studio i afegeix el <strong>Programa</strong>.
          </p>
        )}
      </div>
    </section>

    {reglamentTeaser.length ? (
      <section id="reglament" class="mx-auto max-w-6xl px-4 py-10">
        <p class="font-display text-sm font-semibold uppercase tracking-[0.25em] text-fau-600">Les regles del joc</p>
        <h2 class="font-display mt-1 text-3xl font-bold md:text-4xl">Reglament</h2>
        <div class="mt-4 rounded-lg border border-stone-200 bg-white p-8">
          <PortableText value={reglamentTeaser} />
          <a href="/reglament" class="mt-4 inline-block font-display text-sm font-semibold uppercase tracking-widest text-fau-600 underline-offset-4 hover:underline">
            Llegir reglament sencer →
          </a>
        </div>
      </section>
    ) : null}

    <section id="sponsors" class="mx-auto max-w-6xl px-4 pb-16 pt-10">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.25em] text-fau-600">Ho fan possible</p>
      <h2 class="font-display mt-1 text-3xl font-bold md:text-4xl">Amb el suport de</h2>
      {sponsors.length ? (
        <>
          {((groups) => (
            <>
              {groups.principals.length > 0 && (
                <>
                  <p class="mt-8 text-xs font-bold uppercase tracking-[0.2em] text-fau-600">Patrocinadors</p>
                  <ul class="mt-3 grid grid-cols-2 items-stretch gap-4 md:grid-cols-3">
                    {groups.principals.map((s) => (
                      <SponsorLogo s={s} gran />
                    ))}
                  </ul>
                </>
              )}
              {groups.institucions.length > 0 && (
                <>
                  <p class="mt-8 text-xs font-bold uppercase tracking-[0.2em] text-stone-600">Institucions</p>
                  <ul class="mt-3 grid grid-cols-2 items-center gap-4 md:grid-cols-4">
                    {groups.institucions.map((s) => (
                      <SponsorLogo s={s} />
                    ))}
                  </ul>
                </>
              )}
              {groups.colaboradors.length > 0 && (
                <>
                  <p class="mt-8 text-xs font-bold uppercase tracking-[0.2em] text-stone-600">Col·laboradors</p>
                  <ul class="mt-3 grid grid-cols-2 items-stretch gap-4 md:grid-cols-4">
                    {groups.colaboradors.map((s) => (
                      <SponsorLogo s={s} />
                    ))}
                  </ul>
                </>
              )}
            </>
          ))({
            principals: sponsors.filter((s) => s.categoria === 'principal'),
            institucions: sponsors.filter((s) => s.categoria === 'institucional'),
            colaboradors: sponsors.filter((s) => s.categoria !== 'principal' && s.categoria !== 'institucional'),
          })}
        </>
      ) : (
        <p class="mt-2 text-sm text-stone-600">
          Pendent d'omplir: crea documents <strong>Sponsor</strong> a l'Studio (nom, logo, url, categoria, ordre).
        </p>
      )}
    </section>
    </div>
  </main>

  <Footer />
</Layout>
