---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PortableText from '../components/PortableText.astro';
import { sanity, queries } from '../lib/sanity';

const edicio = await sanity.fetch<{ any?: number; reglament?: any[] }>(queries.edicioActual);
---
<Layout title={`Reglament ${edicio?.any ?? ''} — Cursa del Fau`}>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12">
    <p><a href="/" class="text-sm text-emerald-700 underline">← Inici</a></p>
    <h1 class="mt-2 text-4xl font-black">Reglament {edicio?.any ?? ''}</h1>
    <div class="mt-6 rounded-2xl border border-stone-200 bg-white p-8">
      <PortableText value={edicio?.reglament ?? []} />
    </div>
  </main>
  <Footer />
</Layout>
