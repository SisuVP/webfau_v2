---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PortableText from '../components/PortableText.astro';
import { sanity, queries, type Blocs } from '../lib/sanity';

const edicio = await sanity.fetch<{ any?: number; reglament?: Blocs }>(queries.edicioActual);
---
<Layout title={`Reglament ${edicio?.any ?? ''} — Cursa del Fau`}>
  <Header />
  <div class="bg-stone-100 pt-24 text-stone-900">
    <main class="mx-auto max-w-3xl px-4 py-10">
      <p><a href="/" class="text-sm font-semibold text-fau-600 underline">← Inici</a></p>
      <h1 class="font-display mt-2 text-4xl font-bold md:text-5xl">Reglament {edicio?.any ?? ''}</h1>
      <div class="mt-6 rounded-lg border border-stone-200 bg-white p-8">
        <PortableText value={edicio?.reglament ?? []} />
      </div>
    </main>
  </div>
  <Footer />
</Layout>
