---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PortableText from '../../components/PortableText.astro';
import { sanity, queries } from '../../lib/sanity';

export async function getStaticPaths() {
  try {
    const slugs = await sanity.fetch<{ slug: string }[]>(queries.paginaSlugs);
    return slugs.map((s) => ({ params: { slug: s.slug } }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;

const pagina = await sanity.fetch<{ titol: string; cos?: any[] }>(
  queries.paginaBySlug,
  { slug },
);

if (!pagina) {
  return Astro.redirect('/');
}
---
<Layout title={`${pagina.titol} — Cursa del Fau`}>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12">
    <p><a href="/" class="text-sm text-emerald-700 underline">← Inici</a></p>
    <h1 class="mt-2 text-4xl font-black">{pagina.titol}</h1>
    <div class="mt-6 rounded-2xl border border-stone-200 bg-white p-8">
      <PortableText value={pagina.cos ?? []} />
    </div>
  </main>
  <Footer />
</Layout>
