---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PortableText from '../../components/PortableText.astro';
import Icona from '../../components/Icona.astro';
import Imatge from '../../components/Imatge.astro';
import { sanity, queries, type Blocs } from '../../lib/sanity';

export async function getStaticPaths() {
  try {
    const slugs = await sanity.fetch<{ slug: string }[]>(queries.recorregutSlugs);
    return slugs.map((s) => ({ params: { slug: s.slug } }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;

type Avit = { punt?: string; km?: number };
type Tall = { punt?: string; horaLimit?: string };

const r = await sanity.fetch<{
  nom: string;
  distanciaKm?: number;
  desnivell?: number;
  preu?: number;
  puntSortida?: string;
  descripcio?: Blocs;
  perA?: string;
  horaSortida?: string;
  tempsMaxim?: string;
  alcadaMin?: number;
  alcadaMax?: number;
  avituallaments?: Avit[];
  talls?: Tall[];
  mapaEmbedUrl?: string;
  perfilUrl?: string;
  imatgeUrl?: string;
}>(queries.recorregutBySlug, { slug });

if (!r) {
  return Astro.redirect('/');
}

const fitxa: [string, string][] = [
  ['Distància', r.distanciaKm != null ? `${r.distanciaKm} km` : '—'],
  ['Desnivell +', r.desnivell != null ? `${r.desnivell} m` : '—'],
  ['Alçada min.–màx.', r.alcadaMin != null && r.alcadaMax != null ? `${r.alcadaMin} – ${r.alcadaMax} m` : '—'],
  ['Hora sortida', r.horaSortida ?? '—'],
  ['Temps màxim', r.tempsMaxim ?? '—'],
  ['Preu', r.preu != null ? `${r.preu}€` : '—'],
];

const SITE = import.meta.env.SITE_URL ?? 'https://cursadelfau.org';

// Data de l'edició per al startDate (obligatori a Rich Results)
const ed = await sanity.fetch<{ data?: string; any?: number }>(`{
  "data": *[_type == "edicio" && estat == "actual"][0].data,
  "any": *[_type == "edicio" && estat == "actual"][0].any
}`);
const horaMatch = r.horaSortida?.match(/(\d{1,2})[:.](\d{2})/);
const horaISO = horaMatch ? `${horaMatch[1].padStart(2, '0')}:${horaMatch[2]}:00` : '07:30:00';
const iniciISO = ed?.data ? `${ed.data}T${horaISO}` : undefined;
const passat = iniciISO ? Date.now() >= new Date(iniciISO).getTime() : false;
const descripcioRec = `${r.nom}: ${r.distanciaKm ?? ''} km i ${r.desnivell ?? ''} m positius a Maçanet de Cabrenys.`;

const jsonLdRec = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${r.nom} — Cursa del Fau${ed?.any ? ` ${ed.any}` : ''}`,
  description: descripcioRec,
  sport: 'Trail running',
  ...(iniciISO
    ? {
        startDate: iniciISO,
        endDate: ed?.data ? `${ed.data}T13:00:00` : undefined,
        eventStatus: passat
          ? 'https://schema.org/EventCompleted'
          : 'https://schema.org/EventScheduled',
      }
    : {}),
  location: {
    '@type': 'Place',
    name: 'Camp de Futbol de Maçanet de Cabrenys',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Camp de Futbol, Urbanització Font d’en Coll',
      addressLocality: 'Maçanet de Cabrenys',
      addressRegion: 'Catalunya',
      postalCode: '17720',
      addressCountry: 'ES',
    },
  },
  organizer: { '@type': 'SportsOrganization', name: 'Club Excursionista Maçanetenc', url: SITE },
  url: `${SITE}/recorregut/${slug}`,
  ...(r.imatgeUrl ? { image: [`${r.imatgeUrl}?w=1200&auto=format`] } : {}),
  ...(r.preu != null
    ? {
        offers: {
          '@type': 'Offer',
          price: r.preu,
          priceCurrency: 'EUR',
          url: `${SITE}/pagina/inscripcions`,
          availability: passat
            ? 'https://schema.org/SoldOut'
            : 'https://schema.org/InStock',
        },
      }
    : {}),
};
---
<Layout
  title={`${r.nom} — Cursa del Fau`}
  description={`${r.nom}: ${r.distanciaKm ?? ''} km i ${r.desnivell ?? ''} m positius a Maçanet de Cabrenys.`}
  image={r.imatgeUrl ? `${r.imatgeUrl}?w=1200&auto=format` : undefined}
  jsonLd={jsonLdRec}
>
  <Header />
  <div class="bg-stone-100 pt-24 text-stone-900">
  <main class="mx-auto max-w-3xl px-4 py-10">
    <p><a href="/#curses" class="text-sm font-semibold text-fau-600 underline">← Recorreguts</a></p>
    <h1 class="font-display mt-2 text-4xl font-bold md:text-5xl">{r.nom}</h1>
    {r.perA && (
      <p class="mt-2 text-sm font-semibold uppercase tracking-widest text-stone-500">{r.perA}</p>
    )}

    <section class="mt-6 rounded-lg bg-night-900 p-6 text-white md:p-8">
      <h2 class="font-display text-xl font-bold uppercase tracking-wide text-fau-400">Fitxa tècnica</h2>
      <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 text-sm md:grid-cols-3">
        {fitxa.map(([dt, dd]) => (
          <div>
            <dt class="text-xs uppercase tracking-wider text-stone-400">{dt}</dt>
            <dd class="text-lg font-bold">{dd}</dd>
          </div>
        ))}
      </dl>
      {r.puntSortida && (
        <p class="mt-4 flex items-center gap-2 text-sm text-stone-300"><Icona nom="pin" class="h-4 w-4 text-fau-400" /> Sortida / arribada: {r.puntSortida}</p>
      )}
    </section>

    {r.descripcio?.length ? (
      <div class="mt-6 rounded-lg border border-stone-200 bg-white p-8">
        <PortableText value={r.descripcio} />
      </div>
    ) : null}

    {(r.avituallaments?.length ?? 0) > 0 && (
      <section class="mt-6 rounded-lg border border-stone-200 bg-white p-8">
        <h2 class="font-display text-xl font-bold uppercase tracking-wide">Avituallaments</h2>
        <ol class="mt-4 space-y-2">
          {(r.avituallaments ?? []).map((a) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-dashed border-stone-200 pb-2 text-sm">
              <span class="font-medium">{a.punt}</span>
              {a.km != null && <span class="font-bold text-fau-600">km {a.km}</span>}
            </li>
          ))}
        </ol>
      </section>
    )}

    {(r.talls?.length ?? 0) > 0 && (
      <section class="mt-6 rounded-lg border border-amber-300 bg-amber-50 p-8">
        <h2 class="font-display text-xl font-bold uppercase tracking-wide">Temps de tall</h2>
        <ul class="mt-4 space-y-2 text-sm">
          {(r.talls ?? []).map((t) => (
            <li class="flex items-center gap-2"><Icona nom="crono" class="h-4 w-4 shrink-0" /> <span><strong>{t.punt}</strong>{t.horaLimit ? ` — límit ${t.horaLimit}` : ''}</span></li>
          ))}
        </ul>
      </section>
    )}

    {r.mapaEmbedUrl && (
      <section class="mt-6">
        <h2 class="font-display text-xl font-bold uppercase tracking-wide">Recorregut</h2>
        <div class="mt-4 overflow-hidden rounded-lg border border-stone-200">
          <iframe src={r.mapaEmbedUrl} width="100%" height="480" style="border:0" loading="lazy" title={`Mapa ${r.nom}`} />
        </div>
        <p class="mt-1 text-right text-xs text-stone-400">Powered by Wikiloc</p>
      </section>
    )}

    {r.perfilUrl && (
      <section class="mt-6">
        <h2 class="font-display text-xl font-bold uppercase tracking-wide">Perfil</h2>
        <Imatge
          src={r.perfilUrl}
          alt={`Perfil ${r.nom}`}
          widths={[800, 1400]}
          sizes="(max-width: 768px) 100vw, 768px"
          class="mt-4 w-full rounded-lg border border-stone-200 bg-white shadow"
        />
      </section>
    )}

    <a
      href="/pagina/inscripcions"
      class="font-display mt-8 inline-block rounded-full bg-fau-500 px-8 py-3 text-lg font-semibold uppercase tracking-wide text-night-950 transition hover:bg-fau-400"
    >
      Inscriu-t'hi
    </a>
  </main>
  </div>
  <Footer />
</Layout>
