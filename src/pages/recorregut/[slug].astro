---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PortableText from '../../components/PortableText.astro';
import { sanity, queries } from '../../lib/sanity';

export async function getStaticPaths() {
  try {
    const slugs = await sanity.fetch<{ slug: string }[]>(queries.recorregutSlugs);
    return slugs.map((s) => ({ params: { slug: s.slug } }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;

const r = await sanity.fetch<{
  nom: string;
  distanciaKm?: number;
  desnivell?: number;
  preu?: number;
  puntSortida?: string;
  descripcio?: any[];
  imatgeUrl?: string;
}>(queries.recorregutBySlug, { slug });

if (!r) {
  return Astro.redirect('/');
}
---
<Layout title={`${r.nom} — Cursa del Fau`}>
  <Header />
  <div class="bg-stone-100 pt-24 text-stone-900">
  <main class="mx-auto max-w-3xl px-4 py-10">
    <p><a href="/#curses" class="text-sm font-semibold text-fau-600 underline">← Recorreguts</a></p>
    <h1 class="font-display mt-2 text-4xl font-bold md:text-5xl">{r.nom}</h1>
    {r.imatgeUrl && (
      <img
        src={`${r.imatgeUrl}?w=1200&auto=format`}
        alt={r.nom}
        loading="eager"
        class="mt-6 w-full rounded-2xl object-cover shadow"
      />
    )}
    <dl class="mt-6 grid grid-cols-3 gap-4">
      <div class="rounded-xl bg-white p-4 text-center shadow-sm">
        <dt class="text-xs uppercase text-stone-500">Distància</dt>
        <dd class="text-2xl font-bold">{r.distanciaKm} km</dd>
      </div>
      <div class="rounded-xl bg-white p-4 text-center shadow-sm">
        <dt class="text-xs uppercase text-stone-500">Desnivell</dt>
        <dd class="text-2xl font-bold">{r.desnivell} m</dd>
      </div>
      <div class="rounded-xl bg-white p-4 text-center shadow-sm">
        <dt class="text-xs uppercase text-stone-500">Preu</dt>
        <dd class="text-2xl font-bold text-fau-600">{r.preu}€</dd>
      </div>
    </dl>
    {r.descripcio?.length ? (
      <div class="mt-6 rounded-2xl border border-stone-200 bg-white p-8">
        <PortableText value={r.descripcio} />
      </div>
    ) : null}
    {r.puntSortida && (
      <p class="mt-4 text-sm text-stone-600">📍 Sortida / arribada: {r.puntSortida}</p>
    )}
    <a
      href="/pagina/inscripcions"
      class="font-display mt-8 inline-block rounded-full bg-fau-500 px-8 py-3 text-lg font-semibold uppercase tracking-wide text-night-950 transition hover:bg-fau-400"
    >
      Inscriu-t'hi
    </a>
  </main>
  </div>
  <Footer />
</Layout>
