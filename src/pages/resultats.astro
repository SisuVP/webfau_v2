---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sanity, queries } from '../lib/sanity';

const edicions = await sanity.fetch<{ any: number; resultatsEmbed?: string }[]>(
  queries.edicionsResultats,
);
const actuals = edicions.filter((e) => e.resultatsEmbed);
---
<Layout title="Resultats — Cursa del Fau">
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-12">
    <p><a href="/" class="text-sm text-emerald-700 underline">← Inici</a></p>
    <h1 class="mt-2 text-4xl font-black">Resultats</h1>
    {actuals.length === 0 && (
      <p class="mt-4 text-stone-600">
        Encara no hi ha resultats publicats. Quan l’organització pengi les classificacions a l’edició corresponent, apareixeran aquí soles.
      </p>
    )}
    {actuals.map((e) => (
      <section class="mt-8">
        <h2 class="text-2xl font-bold">Edició {e.any}</h2>
        <div class="mt-4 overflow-hidden rounded-2xl border border-stone-200 bg-white">
          <iframe src={e.resultatsEmbed} width="100%" height="800" style="border:0" loading="lazy" title={`Resultats ${e.any}`} />
        </div>
      </section>
    ))}
    {edicions.length > actuals.length && (
      <section class="mt-8">
        <h2 class="text-xl font-bold">Històric</h2>
        <ul class="mt-2 space-y-1 text-stone-600">
          {edicions.filter((e) => !e.resultatsEmbed).map((e) => (
            <li>Edició {e.any} — pendent de publicar</li>
          ))}
        </ul>
      </section>
    )}
  </main>
  <Footer />
</Layout>
