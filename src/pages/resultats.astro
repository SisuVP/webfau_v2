---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icona from '../components/Icona.astro';
import { sanity, queries } from '../lib/sanity';
import { obteClassificacio, type Classificacio } from '../lib/resultats';

type EventRes = { nom?: string; eventId?: string };
type Edicio = {
  any: number;
  estat?: string;
  data?: string;
  resultatsEmbed?: string;
  resultatsLegacy?: boolean;
  resultatsEvents?: EventRes[];
  resultatsLinks?: { titol?: string; url?: string }[];
};

type TaulaEvent = {
  nom: string;
  eventId: string;
  enllac: string;
  cls: Classificacio;
  /** Dorsal → posició relativa per gènere ("1r M", "8a F") */
  mapaGenere: Map<string, string>;
};

const edicions = await sanity.fetch<Edicio[]>(queries.edicionsResultats);
// Mateix criteri que la home: una edició compta com a passada el dia de la cursa a les 12:00.
// Les futures no es mostren fins que arribi el moment.
const passades = edicions.filter((e) => {
  if (!e.data) return true;
  return Date.now() >= new Date(`${e.data}T12:00:00`).getTime();
});
const teDades = (e: Edicio) => !!e.resultatsEmbed || (e.resultatsLinks?.length ?? 0) > 0;



// Taules API (build-time): per edició sense legacy forçat i amb events.
// Si l'API falla, l'edició cau al legacy automàticament.
const taules = new Map<number, TaulaEvent[]>();
for (const e of edicions) {
  if (e.resultatsLegacy || !e.resultatsEvents?.length) continue;
  const llista: TaulaEvent[] = [];
  for (const ev of e.resultatsEvents) {
    if (!ev.eventId) continue;
    const cls = await obteClassificacio(ev.eventId);
    if (cls) {
      const mapaGenere = new Map<string, string>();
      for (const f of cls.masculina) mapaGenere.set(f.dorsal, `${f.pos} M`);
      for (const f of cls.femenina) mapaGenere.set(f.dorsal, `${f.pos} F`);
      llista.push({
        nom: ev.nom ?? 'General',
        eventId: ev.eventId,
        enllac: e.resultatsEmbed ? `${e.resultatsEmbed}/${ev.eventId}/results` : 'https://sportmaniacs.com/',
        cls,
        mapaGenere,
      });
    }
  }
  if (llista.length) taules.set(e.any, llista);
}
const usaApi = (e: Edicio) => taules.has(e.any);
const dataSnapshot = new Date().toLocaleDateString('ca-ES', { day: 'numeric', month: 'numeric', year: 'numeric' });

const CATEGORIES = [
  { id: 'general', etiqueta: 'General', sencer: 'General', completa: 'general' },
  { id: 'masculina', etiqueta: 'Masc.', sencer: 'Masculina', completa: 'masculina' },
  { id: 'femenina', etiqueta: 'Fem.', sencer: 'Femenina', completa: 'femenina' },
] as const;
---
<Layout title="Resultats — Cursa del Fau">
  <Header />
  <div class="bg-stone-100 pt-24 text-stone-900">
  <main class="mx-auto max-w-5xl px-4 py-10">
    <p><a href="/" class="text-sm font-semibold text-fau-600 underline">← Inici</a></p>
    <h1 class="font-display mt-2 text-4xl font-bold md:text-5xl">Resultats</h1>
    <p class="mt-2 text-stone-600">
      Classificacions de cada edició. També pots consultar el <a href="/pagina/palmares" class="font-semibold text-fau-600 underline">Palmarès històric</a>.
    </p>

    <div class="mt-8 space-y-6">
      {passades.map((e) => (
        <section class={`rounded-lg border p-6 md:p-8 ${e.estat === 'actual' ? 'border-fau-500 bg-orange-50' : 'border-stone-200 bg-white'}`}>
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="font-display text-2xl font-bold">Edició {e.any}</h2>
            {e.estat === 'actual' && (
              <span class="rounded-full bg-fau-500 px-3 py-1 text-xs font-bold uppercase tracking-widest text-night-950">
                Darrera edició
              </span>
            )}
          </div>

          {usaApi(e) ? (
            <>
              {(() => {
                const llista = taules.get(e.any) ?? [];
                const multi = llista.length > 1;
                return (
                  <div data-edicio={e.any}>
                    {multi && (
                      <div data-menu class="mt-6 grid gap-3 sm:grid-cols-3">
                        {llista.map((t) => (
                          <button
                            type="button"
                            data-tria={t.eventId}
                            class="rounded-lg border border-stone-200 bg-stone-50 px-5 py-4 text-left shadow-sm transition hover:border-fau-500 hover:shadow"
                          >
                            <span class="font-display block text-lg font-bold">{t.nom}</span>
                            <span class="mt-0.5 block text-sm text-stone-600">{t.cls.total} arribats a meta</span>
                          </button>
                        ))}
                      </div>
                    )}
                    {llista.map((t) => (
                      <div data-event={t.eventId} hidden={multi} class="mt-6 overflow-hidden rounded-lg border border-stone-200 bg-white" data-classificacio>
                        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-stone-200 bg-stone-50 px-4 py-3">
                          <div class="flex items-center gap-3">
                            {multi && (
                              <button
                                type="button"
                                data-torna
                                class="rounded-full border border-stone-300 px-3 py-1.5 text-sm font-semibold text-stone-600 hover:border-night-950"
                              >
                                ← Distàncies
                              </button>
                            )}
                            <h3 class="font-display text-lg font-bold">{t.nom}</h3>
                          </div>
                          <div class="flex max-w-full flex-wrap gap-2" role="tablist" aria-label={`Classificació ${t.nom}`}>
                            {CATEGORIES.map(
                              (c) =>
                                t.cls[c.id].length > 0 && (
                                  <button
                                    type="button"
                                    role="tab"
                                    data-tab={c.id}
                                    aria-selected={c.id === 'general' ? 'true' : 'false'}
                                    aria-label={`Classificació ${c.completa}`}
                                    title={`Classificació ${c.completa}`}
                                    class="rounded-full border border-stone-300 px-3 py-1.5 text-[13px] font-semibold text-stone-600 sm:px-4 sm:text-sm aria-selected:border-night-950 aria-selected:bg-night-950 aria-selected:text-white"
                                  >
                                    <span class="hidden sm:inline">{c.sencer}</span><span class="sm:hidden">{c.etiqueta}</span>
                                  </button>
                                )
                            )}
                          </div>
                        </div>
                        <div class="px-4 pt-3">
                          <input
                            type="search"
                            data-cerca
                            placeholder="Cerca per nom o dorsal…"
                            aria-label={`Cerca a la classificació ${t.nom}`}
                            class="w-full rounded-full border border-stone-300 px-4 py-2 text-sm focus:border-fau-500 focus:outline-none"
                          />
                        </div>
                        {CATEGORIES.map(
                          (c) =>
                            t.cls[c.id].length > 0 && (
                              <div data-panel={c.id} hidden={c.id !== 'general'} role="tabpanel">
                                <table class="mt-2 w-full text-sm">
                                  <thead>
                              <tr class="border-b border-stone-200 text-left text-xs uppercase tracking-wider text-stone-500">
                                <th scope="col" class="px-4 py-2 font-semibold">Pos.</th>
                                {c.id === 'general' && (
                                  <th scope="col" class="hidden px-2 py-2 font-semibold sm:table-cell">Pos. gèn.</th>
                                )}
                                <th scope="col" class="hidden px-2 py-2 font-semibold sm:table-cell">Dorsal</th>
                                      <th scope="col" class="px-2 py-2 font-semibold">Nom</th>
                                      <th scope="col" class="hidden px-2 py-2 font-semibold md:table-cell">Club</th>
                                      <th scope="col" class="px-4 py-2 text-right font-semibold">Temps</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    {t.cls[c.id].map((f) => (
                                      <tr data-nom={f.nom} data-dorsal={f.dorsal} class={`border-b border-stone-100 ${f.pos <= 3 ? 'bg-orange-50' : ''}`}>
                                        <td class="px-4 py-2">
                                          <span
                                            class={`inline-flex h-7 w-7 items-center justify-center rounded-full text-xs font-bold ${f.pos <= 3 ? 'bg-fau-500 text-night-950' : 'bg-stone-100 text-stone-700'}`}
                                          >
                                      {f.pos}
                                    </span>
                                  </td>
                                  {c.id === 'general' && (
                                    <td class="hidden px-2 py-2 tabular-nums text-stone-500 sm:table-cell">
                                      {t.mapaGenere.get(f.dorsal) ?? '—'}
                                    </td>
                                  )}
                                  <td class="hidden px-2 py-2 tabular-nums text-stone-500 sm:table-cell">{f.dorsal}</td>
                                        <td class="px-2 py-2 font-semibold">{f.nom}</td>
                                        <td class="hidden px-2 py-2 text-stone-600 md:table-cell">{f.club || '—'}</td>
                                        <td class="px-4 py-2 text-right tabular-nums font-semibold">{f.temps}</td>
                                      </tr>
                                    ))}
                              <tr data-buida hidden>
                                <td colspan={c.id === 'general' ? 6 : 5} class="px-4 py-6 text-center text-stone-500">Cap corredor coincideix amb la cerca.</td>
                              </tr>
                                  </tbody>
                                </table>
                              </div>
                            )
                        )}
                        <div class="flex items-center justify-center gap-4 border-t border-stone-200 px-4 py-3" data-paginador>
                          <button
                            type="button"
                            data-anterior
                            class="rounded-full border border-stone-300 px-4 py-1.5 text-sm font-semibold text-stone-600 disabled:opacity-40"
                          >
                            ← Anterior
                          </button>
                          <p class="text-sm tabular-nums text-stone-600">
                            Pàgina <span data-pag>1</span> de <span data-totalpags>1</span>
                          </p>
                          <button
                            type="button"
                            data-seguent
                            class="rounded-full border border-stone-300 px-4 py-1.5 text-sm font-semibold text-stone-600 disabled:opacity-40"
                          >
                            Següent →
                          </button>
                        </div>
                        <p class="px-4 pb-3 text-xs text-stone-500">
                          Dades de Sportmaniacs · {dataSnapshot} ·{' '}
                          <a href={t.enllac} target="_blank" rel="noopener" class="font-semibold text-fau-600 underline">
                            Classificació completa amb filtres
                          </a>
                        </p>
                      </div>
                    ))}
                  </div>
                );
              })()}
              {(e.resultatsLinks?.length ?? 0) > 0 && (
                <ul class="mt-6 grid gap-3 sm:grid-cols-3">
                  {(e.resultatsLinks ?? []).map((l) => (
                    <li>
                      <a href={l.url} target="_blank" rel="noopener" class="block rounded-lg border border-stone-200 bg-stone-50 px-5 py-4 shadow-sm transition hover:border-fau-500 hover:shadow">
                        <span class="font-display block text-lg font-bold">{l.titol}</span>
                        <span class="mt-0.5 flex items-center gap-1.5 text-sm font-semibold text-fau-600">
                          <Icona nom="descarrega" class="h-4 w-4" /> Descarrega el PDF
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </>
          ) : teDades(e) ? (
            <>
              {(e.resultatsLinks?.length ?? 0) > 0 && (
                <ul class="mt-6 grid gap-3 sm:grid-cols-3">
                  {(e.resultatsLinks ?? []).map((l) => (
                    <li>
                      <a href={l.url} target="_blank" rel="noopener" class="block rounded-lg border border-stone-200 bg-stone-50 px-5 py-4 shadow-sm transition hover:border-fau-500 hover:shadow">
                        <span class="font-display block text-lg font-bold">{l.titol}</span>
                        <span class="mt-0.5 flex items-center gap-1.5 text-sm font-semibold text-fau-600">
                          <Icona nom="descarrega" class="h-4 w-4" /> Descarrega el PDF
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {e.resultatsEmbed && (
                <div class="mt-4 overflow-hidden rounded-lg border border-stone-200 bg-white">
                  <iframe src={e.resultatsEmbed} width="100%" height="800" style="border:0" loading="lazy" title={`Resultats ${e.any}`} />
                </div>
              )}
            </>
          ) : e.estat === 'actual' ? (
            <p class="mt-3 text-stone-600">
              Les classificacions d’aquesta edició es publicaran en acabar la cursa. Mentrestant, pots reviure-la a la <a href="/imatges" class="font-semibold text-fau-600 underline">galeria d’imatges</a>.
            </p>
          ) : (
            <p class="mt-3 text-sm text-stone-600">
              Classificacions no disponibles en línia. Consulta les <a href="/imatges" class="font-semibold text-fau-600 underline">fotos de l’edició</a>.
            </p>
          )}
        </section>
      ))}
    </div>
  </main>
  </div>
  <Footer />
  <script>
    // Menú de distàncies per edició: només botons a l'inici, la taula en triar.
    document.querySelectorAll('[data-edicio]').forEach((ed) => {
      const menu = ed.querySelector('[data-menu]') as HTMLElement | null;
      const events = Array.from(ed.querySelectorAll('[data-event]')) as HTMLElement[];
      if (!menu || events.length === 0) return;
      ed.querySelectorAll('[data-tria]').forEach((btn) => {
        btn.addEventListener('click', () => {
          menu.hidden = true;
          events.forEach((ev) => {
            ev.hidden = ev.dataset.event !== (btn as HTMLElement).dataset.tria;
          });
        });
      });
      ed.querySelectorAll('[data-torna]').forEach((btn) => {
        btn.addEventListener('click', () => {
          events.forEach((ev) => {
            ev.hidden = true;
          });
          menu.hidden = false;
        });
      });
    });

    // Per classificació: pestanyes + cercador + paginació (25 files/pàgina).
    // Tot client sobre les taules generades en build.
    const PER_PAGINA = 25;
    document.querySelectorAll('[data-classificacio]').forEach((bloc) => {
      const el = (s: string) => bloc.querySelector(s) as HTMLElement | null;
      const tabs = Array.from(bloc.querySelectorAll('[data-tab]')) as HTMLElement[];
      const panels = Array.from(bloc.querySelectorAll('[data-panel]')) as HTMLElement[];
      const cerca = el('[data-cerca]') as HTMLInputElement | null;
      const pag = el('[data-pag]');
      const totalPags = el('[data-totalpags]');
      const btnAnt = el('[data-anterior]') as HTMLButtonElement | null;
      const btnSeg = el('[data-seguent]') as HTMLButtonElement | null;
      let tab = 'general';
      let q = '';
      let pagina = 1;

      function render() {
        panels.forEach((p) => {
          p.hidden = p.dataset.panel !== tab;
        });
        const actiu = panels.find((p) => p.dataset.panel === tab);
        if (!actiu) return;
        const files = Array.from(actiu.querySelectorAll('tbody tr[data-nom]')) as HTMLElement[];
        const coincidents = files.filter((tr) => {
          if (q === '') return true;
          const txt = normalitza(`${tr.dataset.nom ?? ''} ${tr.dataset.dorsal ?? ''}`);
          return txt.includes(q);
        });
        const total = Math.max(1, Math.ceil(coincidents.length / PER_PAGINA));
        pagina = Math.min(Math.max(1, pagina), total);
        files.forEach((tr) => {
          tr.hidden = true;
        });
        coincidents.slice((pagina - 1) * PER_PAGINA, pagina * PER_PAGINA).forEach((tr) => {
          tr.hidden = false;
        });
        const buida = actiu.querySelector('[data-buida]') as HTMLElement | null;
        if (buida) buida.hidden = coincidents.length > 0;
        if (pag) pag.textContent = String(pagina);
        if (totalPags) totalPags.textContent = String(total);
        if (btnAnt) btnAnt.disabled = pagina <= 1;
        if (btnSeg) btnSeg.disabled = pagina >= total;
      }

      tabs.forEach((btn) => {
        btn.addEventListener('click', () => {
          tab = btn.dataset.tab ?? 'general';
          pagina = 1;
          tabs.forEach((b) => b.setAttribute('aria-selected', b === btn ? 'true' : 'false'));
          render();
        });
      });
      // Cerca insensible a accents: "marti" troba "Martí" (NFD + sense diacrítics)
      const normalitza = (s: string) =>
        s
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '');
      cerca?.addEventListener('input', () => {
        q = normalitza(cerca.value.trim());
        pagina = 1;
        render();
      });
      btnAnt?.addEventListener('click', () => {
        pagina--;
        render();
      });
      btnSeg?.addEventListener('click', () => {
        pagina++;
        render();
      });
      render();
    });
  </script>
</Layout>
