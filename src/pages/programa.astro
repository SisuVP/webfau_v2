---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PortableText from '../components/PortableText.astro';
import { sanity, queries } from '../lib/sanity';

const edicio = await sanity.fetch<{ any?: number; programa?: any[] }>(queries.edicioActual);
---
<Layout title={`Programa ${edicio?.any ?? ''} — Cursa del Fau`}>
  <Header />
  <div class="bg-stone-100 pt-24 text-stone-900">
    <main class="mx-auto max-w-3xl px-4 py-10">
      <p><a href="/" class="text-sm font-semibold text-fau-600 underline">← Inici</a></p>
      <h1 class="font-display mt-2 text-4xl font-bold md:text-5xl">Programa {edicio?.any ?? ''}</h1>
      <div class="mt-6 rounded-lg bg-night-900 p-8 text-stone-100">
        <div class="richtext richtext-dark text-sm leading-relaxed">
          <PortableText value={edicio?.programa ?? []} />
        </div>
      </div>
    </main>
  </div>
  <Footer />
</Layout>
