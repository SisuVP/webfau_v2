---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PortableText from '../components/PortableText.astro';
import { sanity, queries } from '../lib/sanity';

const edicio = await sanity.fetch<{ any?: number; programa?: any[] }>(queries.edicioActual);
---
<Layout title={`Programa ${edicio?.any ?? ''} — Cursa del Fau`}>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-12">
    <p><a href="/" class="text-sm text-emerald-700 underline">← Inici</a></p>
    <h1 class="mt-2 text-4xl font-black">Programa {edicio?.any ?? ''}</h1>
    <div class="mt-6 rounded-2xl bg-stone-950 p-8 text-stone-100">
      <div class="richtext richtext-dark text-sm leading-relaxed">
        <PortableText value={edicio?.programa ?? []} />
      </div>
    </div>
  </main>
  <Footer />
</Layout>
