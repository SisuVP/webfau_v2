---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { sanity } from '../../lib/sanity';

// Pàgina interna (noindex + fora del sitemap + disallow a robots.txt).
// Renderitzada en BUILD (fetch servidor, sense CORS): mostra per edició
// què falta (embed, events, snapshots) i l'ordre exacta per completar-ho.
// Només lectura: no modifica res.
type Item = { nom?: string };
type EdicioEstat = {
  any: number;
  resultatsEmbed?: string;
  resultatsMode?: string;
  resultatsEvents?: Item[];
  resultatsSnapshots?: Item[];
};

const normNom = (nom?: string | null) => (nom ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');

const edicions = await sanity.fetch<EdicioEstat[]>(
  `*[_type == "edicio"] | order(any desc){any, resultatsEmbed, resultatsMode, resultatsEvents[]{nom}, resultatsSnapshots[]{nom}}`
);

const marca = (ok: boolean) =>
  `<span class="inline-flex h-6 w-6 items-center justify-center rounded-full text-xs font-bold ${ok ? 'bg-green-100 text-green-800' : 'bg-stone-200 text-stone-500'}">${ok ? '✓' : '✗'}</span>`;
---
<Layout title="Eines internes — Resultats" noindex={true}>
  <Header />
  <div class="bg-stone-100 pt-24 text-stone-900">
    <main class="mx-auto max-w-5xl px-4 py-10">
      <p><a href="/" class="text-sm font-semibold text-fau-600 underline">← Inici</a></p>
      <h1 class="font-display mt-2 text-4xl font-bold">Eines: resultats</h1>
      <p class="mt-2 text-stone-600">
        Estat de cada edició a data del darrer build. Només lectura: no modifica res.
      </p>

      <div class="mt-8 space-y-4">
        {edicions.map((e) => {
          const events = (e.resultatsEvents ?? []).map((x) => x.nom).filter(Boolean) as string[];
          const snaps = (e.resultatsSnapshots ?? []).map((x) => x.nom).filter(Boolean) as string[];
          const nomsEv = new Set(events.map(normNom));
          const orfes = [...new Set([...events, ...snaps])].filter((n) => {
            const k = normNom(n);
            const aEv = nomsEv.has(k);
            const aSnap = snaps.some((s) => normNom(s) === k);
            return (aEv && !aSnap) || (!aEv && aSnap);
          });
          const mode = e.resultatsMode ?? 'auto';
          const taula = mode !== 'iframe' && (mode === 'api' ? events.length > 0 : snaps.length > 0 || events.length > 0);
          const estat = taula ? 'Taula pròpia' : e.resultatsEmbed ? 'iframe' : 'Sense dades';
          const accio = !e.resultatsEmbed
            ? 'Falta la URL incrustada (Fase 1).'
            : events.length === 0
              ? 'Falten els events amb UUID (Fase 2, pas 2).'
              : snaps.length === 0
                ? 'Falten els snapshots: executa `npm run snapshot:resultats`.'
                : 'Complet.';
          return (
            <section class="rounded-lg border border-stone-200 bg-white p-5">
              <h2 class="font-display text-xl font-bold">Edició {e.any}</h2>
              <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
                <div class="flex items-center gap-2">
                  <Fragment set:html={marca(!!e.resultatsEmbed)} />
                  <dt class="text-stone-500">Embed:</dt>
                  <dd class="font-semibold">{e.resultatsEmbed ? 'informat' : 'buit'}</dd>
                </div>
                <div class="flex items-center gap-2">
                  <Fragment set:html={marca(true)} />
                  <dt class="text-stone-500">Font:</dt>
                  <dd class="font-semibold">{mode}</dd>
                </div>
                <div class="flex items-center gap-2">
                  <Fragment set:html={marca(events.length > 0)} />
                  <dt class="text-stone-500">Events ({events.length}):</dt>
                  <dd class="font-semibold">{events.join(', ') || '—'}</dd>
                </div>
                <div class="flex items-center gap-2">
                  <Fragment set:html={marca(snaps.length > 0)} />
                  <dt class="text-stone-500">Snapshots ({snaps.length}):</dt>
                  <dd class="font-semibold">{snaps.join(', ') || '—'}</dd>
                </div>
              </dl>
              {orfes.length > 0 && (
                <p class="mt-2 text-sm font-semibold text-amber-700">Atenció: no aparellen → {orfes.join(', ')}</p>
              )}
              <p class="mt-2 text-sm">
                <span class="font-semibold">Mostra:</span> {estat} · <span class="font-semibold">Acció:</span> {accio}
              </p>
            </section>
          );
        })}
      </div>

      <section class="mt-10 rounded-lg border border-stone-200 bg-white p-6">
        <h2 class="font-display text-xl font-bold">Flux per a una edició nova</h2>
        <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-stone-700">
          <li>
            <strong>Dia de cursa (Studio, 2 min):</strong> enganxa la URL de la cursa a
            <em>Resultats (URL incrustada)</em>, deixa <em>Resultats (font)</em> en Automàtic i publica.
            La web mostra l'iframe immediatament.
          </li>
          <li>
            <strong>Events (Studio):</strong> a <em>Resultats (events Sportmaniacs)</em>, un per distància amb
            l'UUID del botó "Veure classificacions" (<em>.../races/&lt;cursa&gt;/&lt;eventId&gt;/results</em>).
          </li>
          <li>
            <strong>Snapshot (terminal):</strong> <code class="rounded bg-stone-100 px-1.5 py-0.5 text-[13px]">npm run snapshot:resultats -- 2027</code>
            (prerequisits una sola vegada: <code class="rounded bg-stone-100 px-1.5 py-0.5 text-[13px]">npm install</code> i
            <code class="rounded bg-stone-100 px-1.5 py-0.5 text-[13px]">npx sanity login</code>). Puja els JSON i els desa a
            <em>Resultats (snapshots JSON)</em> sense tocar el repo.
          </li>
        </ol>
      </section>
    </main>
  </div>
  <Footer />
</Layout>
